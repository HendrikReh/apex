{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blacksmith-consulting.ai/schemas/agent_spec.schema.json",
  "title": "AgentSpec",
  "type": "object",
  "required": ["agent_id", "description", "spec_version", "tasks", "graph"],
  "additionalProperties": false,
  "patternProperties": {
    "^x_": {}
  },
  "properties": {
    "agent_id": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "spec_version": {
      "type": "string",
      "enum": ["1.0"]
    },
    "tasks": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true,
      "minItems": 1
    },
    "graph": {
      "type": "object",
      "required": ["start_task", "tasks", "edges"],
      "additionalProperties": false,
      "properties": {
        "start_task": { "type": "string", "minLength": 1 },
        "tasks": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true,
          "minItems": 1
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["from", "to"],
            "additionalProperties": false,
            "properties": {
              "from": { "type": "string", "minLength": 1 },
              "to": { "type": "string", "minLength": 1 },
              "condition_key": { "type": ["string", "null"], "minLength": 1 }
            }
          }
        }
      }
    },
    "checkpoints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["checkpoint_id", "after_task"],
        "additionalProperties": false,
        "properties": {
          "checkpoint_id": { "type": "string", "minLength": 1 },
          "after_task": { "type": "string", "minLength": 1 },
          "approval_type": {
            "type": "string",
            "enum": ["human", "auto"]
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 0
          },
          "on_timeout": {
            "type": "string",
            "enum": ["approve", "reject"]
          }
        }
      }
    },
    "retrieval": {
      "type": "object",
      "required": ["mode", "top_k", "enable_rewrite"],
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["dense", "sparse", "hybrid", "fts"]
        },
        "top_k": { "type": "integer", "minimum": 1 },
        "per_collection_limit": { "type": ["integer", "null"], "minimum": 1 },
        "enable_rewrite": { "type": "boolean" },
        "plan_steps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["query", "mode", "top_k", "collections"],
            "additionalProperties": false,
            "properties": {
              "query": { "type": "string" },
              "mode": { "type": "string", "enum": ["dense", "sparse", "hybrid", "fts"] },
              "top_k": { "type": "integer", "minimum": 1 },
              "collections": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 },
                "minItems": 1
              },
              "filters": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "tenant": { "type": "string" },
                  "doc_ids": { "type": "array", "items": { "type": "string" } },
                  "tags": { "type": "array", "items": { "type": "string" } },
                  "language": { "type": "string" }
                }
              }
            }
          }
        }
      }
    },
    "context": {
      "type": "object",
      "required": ["template_id", "max_tokens", "max_chunks", "dedupe_strategy"],
      "additionalProperties": false,
      "properties": {
        "template_id": { "type": "string", "minLength": 1 },
        "max_tokens": { "type": "integer", "minimum": 1 },
        "max_chunks": { "type": "integer", "minimum": 1 },
        "dedupe_strategy": {
          "type": "string",
          "enum": ["doc_id", "chunk_id", "semantic", "none"]
        }
      }
    },
    "guardrails": {
      "type": "object",
      "required": ["injection_enabled", "injection_action", "pii_enabled", "policy_classifier_enabled", "safety_classifier_enabled"],
      "additionalProperties": false,
      "properties": {
        "injection_enabled": { "type": "boolean" },
        "injection_action": { "type": "string", "enum": ["flag", "block"] },
        "pii_enabled": { "type": "boolean" },
        "policy_classifier_enabled": { "type": "boolean" },
        "safety_classifier_enabled": { "type": "boolean" }
      }
    },
    "policies": {
      "type": "object",
      "required": ["require_citations", "require_policy_context"],
      "additionalProperties": false,
      "properties": {
        "require_citations": { "type": "boolean" },
        "require_policy_context": { "type": "boolean" },
        "allowed_collections": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "react": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "max_iterations": { "type": "integer", "minimum": 1 },
        "stop_conditions": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "confidence_threshold": { "type": "number", "minimum": 0, "maximum": 1 },
            "max_actions": { "type": "integer", "minimum": 1 },
            "explicit_stop": { "type": "boolean" }
          }
        },
        "reasoning_prompt": { "type": "string" },
        "action_types": {
          "type": "array",
          "items": { "type": "string", "enum": ["search", "refine_query", "request_detail", "conclude"] }
        },
        "trace_reasoning": { "type": "boolean" },
        "max_history": { "type": "integer", "minimum": 0 }
      }
    },
    "required_tools": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
